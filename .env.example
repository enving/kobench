# Kopieren nach .env (wird nicht committet). Nur eine Anbieter-Gruppe ausfüllen.

# Antwortmodell: mistral (Standard) | openai | anthropic | claude-cli
KOBENCH_ANBIETER=mistral
MISTRAL_API_KEY=

# Alternativ: jeder OpenAI-kompatible Endpunkt, auch lokal (Ollama, LM Studio, vLLM)
# KOBENCH_ANBIETER=openai
# KOBENCH_BASE_URL=http://localhost:11434/v1
# KOBENCH_API_KEY=
# KOBENCH_MODELL=llama3.1

# Alternativ: Claude
# KOBENCH_ANBIETER=anthropic
# ANTHROPIC_API_KEY=

# Der Richter kann ein anderes (stärkeres) Modell sein
# KOBENCH_RICHTER_ANBIETER=anthropic
# KOBENCH_RICHTER=claude-sonnet-5-5

# Embeddings für Hybrid, Kundenakte, Agent (OpenAI-kompatibel)
# KOBENCH_EMBED_ANBIETER=openai
# KOBENCH_EMBED_BASE_URL=http://localhost:11434/v1
# KOBENCH_EMBED_MODELL=nomic-embed-text
